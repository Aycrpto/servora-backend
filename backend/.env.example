# Servora backend environment — copy this file to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real keys. Start with Paystack TEST keys.

# ---- Database (Postgres / Neon) ----
# Connection string from the Neon dashboard (pooled endpoint). Never commit it.
# Empty = the server still boots, but database-backed API routes answer 503.
DATABASE_URL=

# ---- Professional sign-up ----
# Closed unless explicitly "true" (it collects government ID photos).
# PRO_SIGNUP_OPEN=

# ---- Paystack ----
# Secret key: SERVER-SIDE ONLY. Never expose to the frontend or commit it.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key: safe to send to the browser (for inline checkout, optional).
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Escrow / commission ----
# Servora commission in basis points. 1200 = 12%.
SERVORA_COMMISSION_BPS=1200
CURRENCY=NGN

# Public site URL used in emailed links (password reset, quotes) and the
# post-payment callback. Production: https://servora.ng
APP_BASE_URL=http://localhost:8321

# ---- Email (Resend) ----
# Without these, sign-up codes, reset links and quote emails are NOT sent
# (the server logs an error; it never prints codes or links).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Servora <no-reply@mail.servora.ng>

# ---- KYC image storage (Cloudflare R2) ----
# Government ID photos and selfies go to a PRIVATE R2 bucket created with the
# EU jurisdiction. Use an R2 API token with Object Read & Write on that bucket
# only. Without all four, registration refuses (IDs are never kept on disk).
# Reviewers get 60-second signed links; nothing in the bucket is public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endpoint jurisdiction: eu (default) → https://<account>.eu.r2.cloudflarestorage.com
R2_JURISDICTION=eu

# ---- Admin ----
# Protects the money-moving endpoints (release, list). Use a long random string.
# Requests must send it as the `x-admin-key` header. Empty = those routes are locked.
ADMIN_API_KEY=

# ---- Server ----
PORT=8321
